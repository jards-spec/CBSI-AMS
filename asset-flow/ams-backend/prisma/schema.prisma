generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
}

model Asset {
  id           String    @id @default(uuid())
  tag          String    @unique
  name         String
  category     String
  status       String    @default("Available")
  assignedTo   Employee? @relation(fields: [employeeId], references: [id])
  employeeId   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Component {
  id           Int      @id @default(autoincrement())
  name         String
  category     String
  manufacturer String?  // <--- Add this line
  model        String?
  total        Int
  remaining    Int
  minQty       Int?
  createdAt    DateTime @default(now())
}

model Accessory {
  id         String   @id @default(uuid())
  name       String
  category   String
  total      Int      @default(0)
  checkedOut Int      @default(0)
}

model Employee {
  id     String   @id @default(uuid())
  name   String
  email  String   @unique
  assets Asset[]
}